    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.uacm.mx/ontologia/tutor#Alumno -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Alumno">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Persona"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uacm.mx/ontologia/tutor#inscribe"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uacm.mx/ontologia/tutor#Optativa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uacm.mx/ontologia/tutor#inscribe"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">9</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.uacm.mx/ontologia/tutor#Materia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.uacm.mx/ontologia/tutor#Tutor"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Impar -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Impar">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Semestre"/>
        <owl:disjointWith rdf:resource="http://www.uacm.mx/ontologia/tutor#Par"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Materia -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Materia"/>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Obligatoria -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Obligatoria">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Materia"/>
        <owl:disjointWith rdf:resource="http://www.uacm.mx/ontologia/tutor#Optativa"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Optativa -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Optativa">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Materia"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Par -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Par">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Semestre"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Persona -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Persona"/>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Semestre -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Semestre"/>
    


    <!-- http://www.uacm.mx/ontologia/tutor#Tutor -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#Tutor">
        <rdfs:subClassOf rdf:resource="http://www.uacm.mx/ontologia/tutor#Persona"/>
    </owl:Class>
    


    <!-- http://www.uacm.mx/ontologia/tutor#sinPrerequisitos -->

    <owl:Class rdf:about="http://www.uacm.mx/ontologia/tutor#sinPrerequisitos">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.uacm.mx/ontologia/tutor#Materia"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.uacm.mx/ontologia/tutor#tienePrerequisito"/>
                                <owl:someValuesFrom rdf:resource="http://www.uacm.mx/ontologia/tutor#Materia"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


